# Copie para %USERPROFILE%\.eco\.env (fora do OneDrive) e preencha. Nunca coloque chaves reais neste arquivo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Palavra de ativação "Ei Eco" (Picovoice Porcupine). Sem estes três, o Eco usa o teclado (Enter para falar).
PORCUPINE_ACCESS_KEY=
ECO_PORCUPINE_PPN=
ECO_PORCUPINE_MODELO_PT=

# Palavra de ativação pelo openWakeWord (sem conta). Nome de um modelo pronto (hey_jarvis, alexa, hey_mycroft,
# hey_marvin, timer, weather) ou o caminho de um arquivo .onnx treinado (ex.: o do "Ei Eco").
# ECO_WAKEWORD_MODELO=hey_jarvis
# ECO_WAKEWORD_MODELO=vosk   # reconhecimento offline que escuta "ei eco" (sem treino); modelo em %USERPROFILE%\.eco\modelos\vosk-model-small-pt-0.3
# ECO_VOSK_FRASE=ei eco
# ECO_WAKEWORD_LIMIAR=0.5

# Opcionais
# ECO_MODO=teclado
# ECO_DADOS_DIR=C:\Users\SEU_USUARIO\OneDrive\Documentos\Eco
# ECO_VOZ_TTS=onyx
# ECO_ESTILO_VOZ=Fale como um locutor de rádio, voz grave, ritmo rápido e confiante.
# ECO_VELOCIDADE_TTS=1.25
# ECO_SILENCIO_SEG=1.0      # segundos de silêncio para ela entender que você terminou (menor = mais rápido, mas pode cortar pausas)
# ECO_LIMIAR_VOZ=0.015
# ECO_LEMBRETES=nao         # desliga o resumo do dia e os avisos antes dos compromissos
# ECO_LEMBRETE_MIN=10       # quantos minutos antes de cada compromisso da Agenda ela avisa
# ECO_CONVERSA_SEG=12       # depois de responder, continua ouvindo sem "ei eco" por tantos segundos de silêncio; 0 desliga
# ECO_MODELO_CHAT=claude-haiku-5-5   # modelo do chat da janela principal (o mais barato, como na voz)
# ECO_ESFORCO_CHAT=low      # esforço de raciocínio do chat: low, medium ou high
# ECO_MODELO_GRAFO=claude-haiku-5-5  # modelo que extrai ideias e ligações das conversas para o grafo
# ECO_GRAFO_TETO_USD=1      # gasto mensal máximo só com a análise do grafo (depois dele a análise pausa)
# ECO_ORCAMENTO_USD=9       # orçamento do mês (Claude + OpenAI); acima de 80% o log avisa
# ECO_PRECO_TRANSCRICAO_MIN=0.003  # US$ por minuto transcrito (estimativa oficial da OpenAI para gpt-4o-mini-transcribe)
# ECO_BACKUP_HORAS=24       # backup automático do banco (conversas e grafo) a cada tantas horas; 0 desliga
# ECO_BACKUP_MANTER=14      # quantas cópias automáticas guardar em ~/.eco/backups (manuais nunca são apagadas)
# ECO_PRECO_FALA_MIN=0.017  # US$ por minuto de voz gerada (gpt-4o-mini-tts): estimativa; calibre com o painel de uso da OpenAI

# Orbe (janela visual da Eco)
# ECO_VISUAL=nao            # desliga a janela
# ECO_ORBE_TAMANHO=medio   # pequeno (320), medio (480, padrão), grande (640), tela ou um número em pixels; o menu do orbe também troca
# ECO_ORBE_TOM=148          # tom de 100 (verde floresta) a 210 (azul)
# ECO_ORBE_TELA=0.7         # tamanho do orbe em tela cheia (0.3 a 1.2, fração da altura da tela)
# ECO_PARTICULAS=1.0        # 0.5 = metade das faíscas (PC mais fraco)
# ECO_MOVIMENTO_REDUZIDO=sim # a janela principal abre só com fade (por padrão segue "efeitos de animação" do Windows)
# ECO_SONS=nao             # desliga os sons de começar/terminar de ouvir
# ECO_FILTRO_VOZ=nao        # desliga o filtro local de ruído (Silero VAD) que descarta gravações sem voz antes da transcrição

# Janela principal
# ECO_FUNDO=medio           # partículas de fundo atrás das abas: desligado, baixo, medio (padrão) ou alto
# ECO_GRAFO_VISTA=orbe      # vista inicial da aba Grafo: orbe (esfera 3D, padrão) ou 2d
# ECO_GRAFO_QUALIDADE=medio # detalhe da orbe do grafo: baixo, medio (padrão) ou alto
